{
    "name": "kowada-gmbh/error-reporting-bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "description": "Shared Symfony bundle that automatically e-mails logged errors to a configurable address.",
    "keywords": ["symfony", "symfony-bundle", "error-reporting", "monolog"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "monolog/monolog": "^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mailer": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/phpunit-bridge": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Kowada\\ErrorReportingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kowada\\ErrorReportingBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
