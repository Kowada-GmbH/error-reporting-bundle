<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{{ subject }}</title>
    </head>
    <body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; color: #333;">
        <h2 style="margin: 0 0 16px;">{{ level|upper }}: {{ exceptionMessage }}</h2>
        <p style="margin: 0 0 8px;"><strong>Occurred at:</strong> {{ occurredAt|date('Y-m-d H:i:s') }}</p>
        <p style="margin: 0 0 8px;"><strong>Source:</strong> {{ exceptionFile }}:{{ exceptionLine }}</p>
        <p style="margin: 16px 0 0;">{{ message }}</p>
    </body>
</html>
